# ─── AutoLead v3 Environment Variables ───────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://autolead:autolead_secret@localhost:5432/autolead

# PostgreSQL credentials (used by docker-compose)
POSTGRES_DB=autolead
POSTGRES_USER=autolead
POSTGRES_PASSWORD=autolead_secret
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=Your Name
SMTP_FROM_EMAIL=you@gmail.com

# ── IMAP (reply detection) ────────────────────────────────────────────────────
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=you@gmail.com
IMAP_PASSWORD=your-app-password
IMAP_SSL=true

# ── Ollama (local AI) ─────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT=120

# ── Scheduler ────────────────────────────────────────────────────────────────
SCHEDULE_HOUR=9
DAILY_EMAIL_LIMIT=50
DAILY_WHATSAPP_LIMIT=20
AUTO_SEND_ENABLED=false

# ── Ports (docker-compose only) ──────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=5173
