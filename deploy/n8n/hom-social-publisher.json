{
  "id": "HOMsocialPub0001",
  "name": "HOM · Social media publisher",
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none"
  },
  "nodes": [
    {
      "id": "d3e0e0a1-0001-4a51-9c0d-000000000001",
      "name": "Every minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "d3e0e0a1-0002-4a51-9c0d-000000000002",
      "name": "Ask HOM to publish due posts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        300,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.HOM_API }}/social/hooks/tick",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-HOM-Secret",
              "value": "={{ $env.HOM_WA_SECRET }}"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      }
    }
  ],
  "connections": {
    "Every minute": {
      "main": [
        [
          {
            "node": "Ask HOM to publish due posts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}