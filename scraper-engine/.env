# Scraper Engine Configuration
PORT=3001
FASTAPI_URL=http://localhost:8000

# Ollama (local AI) — shared with FastAPI backend
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT=300

# Browser settings
HEADLESS=false
USER_DATA_DIR=./browser-data

# Scraping limits
MAX_RESULTS=20
PAGE_DELAY_MIN=2000
PAGE_DELAY_MAX=5000
SCROLL_DELAY_MIN=800
SCROLL_DELAY_MAX=2000

# Concurrency
MAX_CONCURRENT=1
