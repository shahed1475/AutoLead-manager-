# ── App ──────────────────────────────────────────────────────
DEBUG=false

# ── Database & Redis ──────────────────────────────────────────
DATABASE_URL=postgresql://autolead:autolead_secret@localhost:5433/autolead
REDIS_URL=redis://localhost:6379/0

# ── Ollama (local AI) ─────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT=300

# ── Email SMTP ────────────────────────────────────────────────
# Gmail: enable "App Passwords" and use that 16-char password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_NAME=Your Name
SMTP_FROM_EMAIL=you@gmail.com

# ── WhatsApp ──────────────────────────────────────────────────
WHATSAPP_WAIT_TIME=15
WHATSAPP_CLOSE_TAB=true

# ── Scheduler ─────────────────────────────────────────────────
SCHEDULE_HOUR=9
DAILY_EMAIL_LIMIT=50
DAILY_WHATSAPP_LIMIT=20

# ── Scraper ───────────────────────────────────────────────────
SCRAPER_HEADLESS=true
SCRAPER_DELAY_MIN=2.0
SCRAPER_DELAY_MAX=5.0
